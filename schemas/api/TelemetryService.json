{
  "openapi": "3.0.4",
  "info": {
    "title": "SmartHome.Telemetry",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/Telemetry/{deviceId}": {
      "get": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Получить телеметрические данные для указанного устройства за заданный период времени.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Идентификатор устройства.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Начальная дата и время периода.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Конечная дата и время периода.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ с данными телеметрии.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TelemetryData"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры запроса.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Устройство не найдено.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "TelemetryData": {
        "required": [
          "data"
        ],
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "Время фиксации данных.",
            "format": "date-time"
          },
          "data": {
            "type": "string",
            "description": "JSON-данные телеметрии.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Телеметрические данные устройства."
      }
    }
  },
  "tags": [
    {
      "name": "Telemetry"
    }
  ]
}