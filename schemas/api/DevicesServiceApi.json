{
  "openapi": "3.0.4",
  "info": {
    "title": "SmartHome.Devices",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/devices/house/{houseId}": {
      "get": {
        "tags": [
          "Devices"
        ],
        "summary": "Получить список устройств для указанного дома.",
        "parameters": [
          {
            "name": "houseId",
            "in": "path",
            "description": "Идентификатор дома.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Устройства успешно получены.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректный запрос.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/{deviceId}": {
      "get": {
        "tags": [
          "Devices"
        ],
        "summary": "Получить информацию об устройстве по его идентификатору.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Идентификатор устройства.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Устройство успешно получено.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceDto"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный запрос.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Устройство не найдено.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Devices"
        ],
        "summary": "Обновить информацию об устройстве.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Идентификатор устройства.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "Информация об устройстве для обновления.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Устройство успешно обновлено.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceDto"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный запрос.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Устройство не найдено.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Devices"
        ],
        "summary": "Удалить устройство по его идентификатору.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "description": "Идентификатор устройства.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Устройство успешно удалено."
          },
          "400": {
            "description": "Некорректный запрос.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Устройство не найдено.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "post": {
        "tags": [
          "Devices"
        ],
        "summary": "Создать новое устройство.",
        "requestBody": {
          "description": "Информация об устройстве для создания.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Устройство успешно создано.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceDto"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный запрос.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devicetypes": {
      "get": {
        "tags": [
          "DeviceTypes"
        ],
        "summary": "Получить список доступных типов устройств.",
        "responses": {
          "200": {
            "description": "Типы устройств успешно получены.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeviceType"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeviceDto": {
        "required": [
          "houseId",
          "typeName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Идентификатор устройства.",
            "format": "int64"
          },
          "houseId": {
            "type": "integer",
            "description": "Идентификатор дома, к которому принадлежит устройство.",
            "format": "int64"
          },
          "typeName": {
            "type": "string",
            "description": "Наименование типа устройства.",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "Наименование устройства.",
            "nullable": true
          },
          "location": {
            "type": "string",
            "description": "Местоположение устройства.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Информация об устройстве в рамках умного дома."
      },
      "DeviceType": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Идентификатор типа устройства.",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "description": "Наименование типа.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Тип устройства в рамках умного дома."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      }
    }
  },
  "tags": [
    {
      "name": "Devices"
    },
    {
      "name": "DeviceTypes"
    }
  ]
}