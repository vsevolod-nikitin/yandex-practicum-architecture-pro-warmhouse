@startuml UserService
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Component_Ext(gateway, "ApiGateway", "Маршрутизация запросов к соответствующим сервисам")
ComponentDb(userDb, "UserDB", "PostgreSQL", "Хранение данных пользователей и домов")

Container_Boundary(userService, "UserService", "Управление пользователями и домами") {
    Component(authController, "AuthController", "REST API для аутентификации и управления сессиями")
    Component(userController, "UsersController", "REST API для управления пользователями (CRUD)")
    Component(homeController, "HomesController", "REST API для управления домами и устройствами в домах (CRUD)")

    Component(authService, "AuthService", "Аутентификация, управление сессиями")
    Component(userServiceImpl, "UsersService", "Бизнес-логика управления пользователями")
    Component(homeService, "HomesService", "Бизнес-логика управления домами и устройствами в домах")
        
    Component(authRepository, "AuthRepository", "Доступ к данным аутентификации и сессий")
    Component(userRepository, "UsersRepository", "Доступ к данным пользователей")
    Component(homeRepository, "HomesRepository", "Доступ к данным домов и устройств в домах")
    Rel(authController, authService, "Использует")
    Rel(userController, userServiceImpl, "Использует")
    Rel(homeController, homeService, "Использует")

    Rel(authService, authRepository, "Взаимодействует с данными через")
    Rel(userServiceImpl, userRepository, "Взаимодействует с данными через")
    Rel(homeService, homeRepository, "Взаимодействует с данными через")

    Rel(authRepository, userDb, "Читает и записывает данные")
    Rel(userRepository, userDb, "Читает и записывает данные")
    Rel(homeRepository, userDb, "Читает и записывает данные")
}

Rel(gateway, authController, "Обращается к")
Rel(gateway, userController, "Обращается к")
Rel(gateway, homeController, "Обращается к")

@enduml